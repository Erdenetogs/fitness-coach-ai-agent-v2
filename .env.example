# Энэ файлыг .env нэрээр хуулаад түлхүүрээ бичнэ. .env-ийг GitHub руу БҮҮ push хий.
# Түлхүүр байхгүй бол агент "демо горим"-оор (mock) ажиллана.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Хоосон бол fitcoach.db (SQLite) файл ашиглана. Render дээр Neon-ий холбох хаягийг бичнэ:
# DATABASE_URL=postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
